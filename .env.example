# LGMED-IMMS environment - TEMPLATE ONLY. Placeholder values; no real secrets.
#
# Copy to <venv>/lgmed.env (read automatically by config/settings.py), or to
# the file your service manager loads (e.g. systemd EnvironmentFile=), then
# fill in real values. Never commit the filled-in copy: .gitignore excludes
# .env, lgmed.env and venv/.
#
# Restrict the real file to the service account:
#     Linux:    chown root:lgmed /etc/lgmed-imms/lgmed.env && chmod 640 /etc/lgmed-imms/lgmed.env
#     Windows:  icacls lgmed.env /inheritance:r /grant:r "<service account>:R" "Administrators:F"
#
# Settings marked REQUIRED make a production server (DJANGO_DEBUG unset or 0)
# refuse to start when missing. See docs/security/PRODUCTION_DEPLOYMENT.md.

# --- Core -------------------------------------------------------------------

# Production: leave unset (or 0). Development machines only: 1.
DJANGO_DEBUG=0

# REQUIRED. At least 50 random characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-with-output-of-the-command-above

# REQUIRED. The hostname(s) users type, comma-separated. No "*".
DJANGO_ALLOWED_HOSTS=lgmed-imms.example.gov.ph

# Full origins (scheme + host [+ port]) allowed to POST forms.
DJANGO_CSRF_TRUSTED_ORIGINS=https://lgmed-imms.example.gov.ph

# --- HTTPS and the reverse proxy -------------------------------------------

# 1 only when a reverse proxy terminates TLS and OVERWRITES X-Forwarded-Proto.
DJANGO_BEHIND_TLS_PROXY=1
# 1 only when that proxy APPENDS the client address to X-Forwarded-For
# (nginx: proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for).
DJANGO_TRUST_X_FORWARDED_FOR=1
# Redirect plain HTTP to HTTPS (default 1).
DJANGO_SSL_REDIRECT=1
# HSTS max-age in seconds. Start at 3600 on a first deployment; raise to
# 31536000 once HTTPS is confirmed on every hostname.
DJANGO_HSTS_SECONDS=3600
DJANGO_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_HSTS_PRELOAD=0
# 1 = send the Content-Security-Policy as report-only (staging trials only).
DJANGO_CSP_REPORT_ONLY=0

# --- Database (MySQL / MariaDB) ---------------------------------------------

MYSQL_DATABASE=lgmedimms
# A dedicated account with rights on this database only (see the deployment guide).
MYSQL_USER=lgmedimms
# REQUIRED in production.
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# CA certificate path, when the database is on another machine (enables TLS).
MYSQL_SSL_CA=

# --- Cache (sign-in throttle) ------------------------------------------------

# Empty = per-process memory (fine for one Daphne process).
# Several processes: redis://127.0.0.1:6379/1, or "database" (then run
# `python manage.py createcachetable`).
DJANGO_CACHE_LOCATION=

# Sign-in throttle (defaults shown).
LGMED_LOGIN_THROTTLE_WINDOW=900
LGMED_LOGIN_THROTTLE_PER_USER_IP=5
LGMED_LOGIN_THROTTLE_PER_IP=30
LGMED_LOGIN_THROTTLE_PER_USER=20
LGMED_PASSWORD_MIN_LENGTH=12

# --- reCAPTCHA v3 on the sign-in page (optional) -----------------------------

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_ENFORCE=1

# --- Outgoing email -----------------------------------------------------------
# Without EMAIL_HOST, mail (including temporary passwords) is printed to the
# server log. Configure before creating accounts in production.

EMAIL_HOST=smtp.example.gov.ph
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=lgmed-imms@example.gov.ph
EMAIL_HOST_PASSWORD=replace-with-the-smtp-or-app-password
DEFAULT_FROM_EMAIL=LGMED-IMMS <lgmed-imms@example.gov.ph>
ACCOUNT_NOTIFY_EMAILS=

# --- e-SIRA digital signing ----------------------------------------------------

ESIRA_SIGNING_BACKEND=pkcs12
# Comma-separated paths to the DICT PNPKI root/intermediate CA certificates.
ESIRA_PNPKI_TRUST_ROOTS=
# Fernet key for stored signing certificates. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back it up separately from the database; losing it makes stored certificates unreadable.
ESIRA_CREDENTIAL_KEY=
ESIRA_CHECK_REVOCATION=0
ESIRA_TSA_URL=
ESIRA_MAX_UPLOAD_MB=25

# --- Development-only switches (ignored when DJANGO_DEBUG is off) -------------
# DJANGO_LAN_ACCESS=1
# LGMED_MFA_OFF=1
# ESIRA_ALLOW_UNTRUSTED_CERTIFICATES=1
